{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japan-budget-tool/schemas/prices.schema.json",
  "title": "Price records",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "label", "category", "basis", "low", "expected", "high", "asOf", "source", "confidence"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "label": { "type": "string", "minLength": 1 },
      "cityId": { "type": "string" },
      "category": {
        "type": "string",
        "enum": ["getting_there", "lodging", "intercity_transport", "local_transport", "food", "activities", "connectivity", "shopping", "reserves"]
      },
      "tier": {
        "type": "string",
        "enum": ["hostel", "business", "midrange", "upscale", "luxury", "ryokan_hanmeshi"]
      },
      "basis": {
        "type": "string",
        "enum": ["per_room_per_night", "per_person_per_night", "per_person_per_day", "per_person_per_leg", "per_person_per_trip", "per_party_per_trip", "per_person_per_use"]
      },
      "low": { "type": "integer", "minimum": 0 },
      "expected": { "type": "integer", "minimum": 0 },
      "high": { "type": "integer", "minimum": 0 },
      "asOf": { "type": "string", "format": "date" },
      "source": { "type": "string", "minLength": 1 },
      "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
      "notes": { "type": "string" }
    }
  }
}
