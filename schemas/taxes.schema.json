{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://japan-budget-tool/schemas/taxes.schema.json",
  "title": "Accommodation and departure taxes",
  "type": "object",
  "additionalProperties": false,
  "required": ["accommodationTax", "departureTax"],
  "properties": {
    "accommodationTax": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "cityId", "effectiveFrom", "effectiveTo", "structure", "asOf", "source", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "cityId": { "type": "string" },
          "effectiveFrom": { "type": "string", "format": "date" },
          "effectiveTo": { "type": ["string", "null"], "format": "date" },
          "structure": {
            "type": "string",
            "enum": ["bracket_per_person_per_night", "flat_per_person_per_night", "percentage_per_person_per_night"]
          },
          "brackets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["minJpy", "maxJpy", "taxJpy"],
              "properties": {
                "minJpy": { "type": "integer", "minimum": 0 },
                "maxJpy": { "type": ["integer", "null"], "minimum": 0 },
                "taxJpy": { "type": "integer", "minimum": 0 }
              }
            }
          },
          "flatTaxJpy": { "type": "integer", "minimum": 0 },
          "percentageOfRate": { "type": "number", "minimum": 0, "maximum": 100 },
          "bracketEdgeWarningThresholdPct": { "type": "number", "minimum": 0, "maximum": 100 },
          "asOf": { "type": "string", "format": "date" },
          "source": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
          "notes": { "type": "string" }
        }
      }
    },
    "departureTax": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "amountJpy", "basis", "collectedVia", "asOf", "source", "confidence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "amountJpy": { "type": "integer", "minimum": 0 },
        "basis": { "type": "string", "const": "per_person_per_trip" },
        "collectedVia": { "type": "string" },
        "asOf": { "type": "string", "format": "date" },
        "source": { "type": "string", "minLength": 1 },
        "confidence": { "type": "string", "enum": ["high", "medium", "low"] },
        "notes": { "type": "string" }
      }
    }
  }
}
